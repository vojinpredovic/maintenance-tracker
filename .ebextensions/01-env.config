# Non-secret settings only. Secrets (SESSION_SECRET, GOOGLE_*, CALLBACK_URL)
# are mapped from Parameter Store on the environment itself, so no account
# details or values live in this repo. See docs/aws-migration.md §7.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    TABLE_NAME: maintenance-tracker
    AWS_REGION: us-east-2
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    RetentionInDays: 7
    DeleteOnTerminate: false
