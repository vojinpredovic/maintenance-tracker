GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
CALLBACK_URL=http://localhost:3000/auth/google/callback
SESSION_SECRET=a_long_random_string_here
NODE_ENV=development
PORT=3000

# DynamoDB. Locally, credentials come from your AWS CLI login (aws sso login).
# In production these are set by Elastic Beanstalk; secrets come from Parameter Store.
TABLE_NAME=maintenance-tracker-dev
AWS_REGION=us-east-2
# Only for DynamoDB Local (used in CI):
# DYNAMODB_ENDPOINT=http://localhost:8000
